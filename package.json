{
  "name": "team-flow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "e2e"
  ],
  "scripts": {
    "dev:fe": "npm run dev --workspace=frontend",
    "dev:be": "npm run start:dev --workspace=backend",
    "lint:fe": "npm run lint --workspace=frontend",
    "lint:be": "npm run lint --workspace=backend",
    "typecheck:fe": "tsc -p frontend/tsconfig.app.json --noEmit",
    "typecheck:be": "tsc -p backend/tsconfig.build.json --noEmit",
    "test": "npm run typecheck:be && npm run typecheck:fe",
    "test:e2e": "npm run test --workspace=e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.40",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "backend/src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
