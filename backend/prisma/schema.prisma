generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  name                 String
  password             String?
  provider             AuthProvider      @default(local)
  refreshToken         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  avatarKey            String?
  cardAssignments      CardAssignee[]    @relation("CardAssignees")
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")

  @@index([email])
  @@map("users")
  cardActivities CardActivity[]
  receivedNotifications Notification[] @relation("ReceivedNotifications")
sentNotifications     Notification[] @relation("SentNotifications")
  comments       Comment[]
  attachments    Attachment[]
  boardSnapshots BoardSnapshot[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Workspace {
  id           String            @id @default(cuid())
  name         String
  ownerId      String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  boards       Board[]
  inviteTokens InviteToken[]
  members      WorkspaceMember[]
  owner        User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        MemberRole @default(member)
  joinedAt    DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Board {
  id          String    @id @default(cuid())
  title       String
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     Column[]
  labels      Label[]
  snapshots   BoardSnapshot[]

  @@index([workspaceId])
  @@map("boards")
}

model Column {
  id        String   @id @default(cuid())
  title     String
  /// Lexicographic Float 정렬 — 앞뒤 position 중간값으로 O(1) 삽입
  position  Float
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cards     Card[]
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, position])
  @@map("columns")
}

model Card {
  id          String       @id @default(cuid())
  title       String
  description String?
  /// Column 내 카드 순서 — Lexicographic Float 방식
  position    Float
  dueDate     DateTime?
  priority    CardPriority @default(none)
  columnId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  column      Column       @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId, position])
  @@map("cards")

  activities     CardActivity[]
  notifications  Notification[]
  comments       Comment[]
  attachments    Attachment[]
  labels         Label[]
  assignees      CardAssignee[]
  checklistItems ChecklistItem[]
}

model CardAssignee {
  cardId     String
  userId     String
  assignedAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation("CardAssignees", fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
  @@map("card_assignees")
}

model ChecklistItem {
  id        String   @id @default(cuid())
  cardId    String
  text      String
  done      Boolean  @default(false)
  /// Card 내 항목 순서 — Lexicographic Float 방식
  position  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, position])
  @@map("checklist_items")
}

model InviteToken {
  id          String    @id @default(cuid())
  token       String    @unique
  workspaceId String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId])
  @@map("invite_tokens")
}

enum AuthProvider {
  local
  google
}

enum MemberRole {
  admin
  member
}

enum CardPriority {
  none
  low
  medium
  high
  urgent
}

enum CardActionType {
  CARD_CREATED
  CARD_TITLE_UPDATED
  CARD_DESCRIPTION_UPDATED
  CARD_MOVED
  CARD_ASSIGNEE_CHANGED
  CARD_DUE_DATE_CHANGED
  CARD_DELETED
  COMMENT_ADDED
  COMMENT_DELETED
  ATTACHMENT_ADDED
  ATTACHMENT_DELETED
  LABEL_ADDED
  LABEL_REMOVED
  CARD_PRIORITY_CHANGED
  CHECKLIST_ITEM_ADDED
  CHECKLIST_ITEM_REMOVED
  CHECKLIST_ITEM_TOGGLED
  ASSIGNEE_ADDED
  ASSIGNEE_REMOVED
}

model CardActivity {
  id         String         @id @default(cuid())
  cardId     String
  userId     String
  actionType CardActionType
  metadata   Json?          // { before: any, after: any, extra: any }
  createdAt  DateTime       @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt(sort: Desc)])
}

enum NotificationType {
  MENTION
  CARD_ASSIGNED
  COMMENT_ADDED
  CARD_DUE_SOON
}

model Notification {
  id         String           @id @default(cuid())
  userId     String                          // 수신자
  actorId    String                          // 발신자
  type       NotificationType
  message    String
  link       String?                         // 클릭 시 이동할 경로
  isRead     Boolean          @default(false)
  cardId     String?
  createdAt  DateTime         @default(now())

  user  User  @relation("ReceivedNotifications", fields: [userId],  references: [id], onDelete: Cascade)
  actor User  @relation("SentNotifications",     fields: [actorId], references: [id], onDelete: Cascade)
  card  Card? @relation(fields: [cardId], references: [id],         onDelete: SetNull)

  @@index([userId, isRead, createdAt(sort: Desc)])
}

model Comment {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt(sort: Desc)])
  @@map("comments")
}

model Attachment {
  id        String   @id @default(cuid())
  cardId    String
  userId    String
  fileName  String
  fileKey   String
  mimeType  String
  fileSize  Int
  createdAt DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt(sort: Desc)])
  @@map("attachments")
}

model Label {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  color     String
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId])
  @@map("labels")
}

model BoardSnapshot {
  id        String   @id @default(cuid())
  boardId   String
  userId    String
  label     String?
  data      Json
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt(sort: Desc)])
  @@map("board_snapshots")
}